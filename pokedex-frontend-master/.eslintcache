,"results":"21","hashOfConfig":"14"},{"size":233,"mtime":1608142195000,"results":"22","hashOfConfig":"14"},{"size":842,"mtime":1608142195000,"results":"23","hashOfConfig":"14"},{"size":3217,"mtime":1608142195000,"results":"24","hashOfConfig":"14"},{"size":1619,"mtime":1608142195000,"results":"25","hashOfConfig":"14"},{"filePath":"26","messages":"27","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},"avivn4",{"filePath":"29","messages":"30","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"31","messages":"32","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"33","messages":"34","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"35","usedDeprecatedRules":"28"},{"filePath":"36","messages":"37","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"38","messages":"39","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"40","usedDeprecatedRules":"28"},{"filePath":"41","messages":"42","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"43","messages":"44","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"45","messages":"46","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"47","messages":"48","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"49","messages":"50","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"51","messages":"52","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/index.js",[],["53","54"],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/App.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/index.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonBrowser.js",["55"],"import { useState, useEffect } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport { NavLink, Route, useParams } from 'react-router-dom';\nimport { getPokemon } from '../store/pokemon';\n\nimport PokemonDetail from './PokemonDetail';\nimport CreatePokemonForm from './CreatePokemonForm';\nimport Fab from './Fab';\n\nconst PokemonBrowser = () => {\n\tconst { pokemonId } = useParams();\n\t// console.log('pokemonId', pokemonId);\n\tconst pokemon = useSelector(state => {\n\t\t// debugger;\n\t\treturn state.pokemon.list.map(pokemonId => state.pokemon[pokemonId]);\n\t});\n\tconst [showForm, setShowForm] = useState(false);\n\n\tconst dispatch = useDispatch();\n\tuseEffect(() => {\n\t\tdispatch(getPokemon());\n\t}, []);\n\t// console.log(pokemon);\n\n\tif (!pokemon) {\n\t\treturn null;\n\t}\n\treturn (\n\t\t<main>\n\t\t\t<nav>\n\t\t\t\t<Fab hidden={showForm} onClick={() => setShowForm(true)} />\n\t\t\t\t{pokemon.map(pokemon => {\n\t\t\t\t\treturn (\n\t\t\t\t\t\t<NavLink key={pokemon.name} to={`/pokemon/${pokemon.id}`}>\n\t\t\t\t\t\t\t<div className={Number.parseInt(pokemonId) === pokemon.id ? 'nav-entry is-selected' : 'nav-entry'}>\n\t\t\t\t\t\t\t\t<div className=\"nav-entry-image\" style={{ backgroundImage: `url('${pokemon.imageUrl}')` }}></div>\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div className=\"primary-text\">{pokemon.name}</div>\n\t\t\t\t\t\t\t\t\t<div className=\"secondary-text\">\n\t\t\t\t\t\t\t\t\t\t{pokemon.no} {pokemon.captured && '(Captured)'}\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</NavLink>\n\t\t\t\t\t);\n\t\t\t\t})}\n\t\t\t</nav>\n\t\t\t{showForm ? (\n\t\t\t\t<CreatePokemonForm hideForm={() => setShowForm(false)} />\n\t\t\t) : (\n\t\t\t\t<Route path=\"/pokemon/:pokemonId\">\n\t\t\t\t\t<PokemonDetail />\n\t\t\t\t</Route>\n\t\t\t)}\n\t\t</main>\n\t);\n};\n\nexport default PokemonBrowser;\n","/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/pokemon.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/items.js",["56","57","58","59"],"export const LOAD_ITEMS = \"items/LOAD_ITEMS\";\nexport const REMOVE_ITEM = \"items/REMOVE_ITEM\";\nexport const UPDATE_ITEM = \"items/UPDATE_ITEM\";\nexport const ADD_ITEM = \"items/ADD_ITEM\";\n\nconst load = (items, pokemonId) => ({\n  type: LOAD_ITEMS,\n  items,\n  pokemonId,\n});\n\nconst update = (item) => ({\n  type: UPDATE_ITEM,\n  item,\n});\n\nconst add = (item) => ({\n  type: ADD_ITEM,\n  item,\n});\n\nconst remove = (itemId, pokemonId) => ({\n  type: REMOVE_ITEM,\n  itemId,\n  pokemonId,\n});\n\nconst initialState = {};\n\nconst itemsReducer = (state = initialState, action) => {\n  switch (action.type) {\n    case LOAD_ITEMS: {\n      const newItems = {};\n      action.items.forEach(item => {\n        newItems[item.id] = item;\n      })\n      return {\n        ...state,\n        ...newItems\n      }\n    }\n    case REMOVE_ITEM: {\n      const newState = { ...state };\n      delete newState[action.itemId];\n      return newState;\n    }\n    case ADD_ITEM:\n    case UPDATE_ITEM: {\n      return {\n        ...state,\n        [action.item.id]: action.item,\n      };\n    }\n    default:\n      return state;\n  }\n};\n\nexport default itemsReducer;\n","/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonDetail.js",["60"],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/CreatePokemonForm.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/Fab.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonItems.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/EditPokemonForm.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/EditItemForm.js",[],{"ruleId":"61","replacedBy":"62"},{"ruleId":"63","replacedBy":"64"},{"ruleId":"65","severity":1,"message":"66","line":22,"column":5,"nodeType":"67","endLine":22,"endColumn":7,"suggestions":"68"},{"ruleId":"69","severity":1,"message":"70","line":6,"column":7,"nodeType":"71","messageId":"72","endLine":6,"endColumn":11},{"ruleId":"69","severity":1,"message":"73","line":12,"column":7,"nodeType":"71","messageId":"72","endLine":12,"endColumn":13},{"ruleId":"69","severity":1,"message":"74","line":17,"column":7,"nodeType":"71","messageId":"72","endLine":17,"endColumn":10},{"ruleId":"69","severity":1,"message":"75","line":22,"column":7,"nodeType":"71","messageId":"72","endLine":22,"endColumn":13},{"ruleId":"65","severity":1,"message":"66","line":23,"column":5,"nodeType":"67","endLine":23,"endColumn":16,"suggestions":"76"},"no-native-reassign",["77"],"no-negated-in-lhs",["78"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'dispatch'. Either include it or remove the dependency array.","ArrayExpression",["79"],"no-unused-vars","'load' is assigned a value but never used.","Identifier","unusedVar","'update' is assigned a value but never used.","'add' is assigned a value but never used.","'remove' is assigned a value but never used.",["80"],"no-global-assign","no-unsafe-negation",{"desc":"81","fix":"82"},{"desc":"83","fix":"84"},"Update the dependencies array to be: [dispatch]",{"range":"85","text