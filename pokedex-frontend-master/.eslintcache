["53","54"],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/App.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/index.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonBrowser.js",["55"],"import { useState, useEffect } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport { NavLink, Route, useParams } from 'react-router-dom';\nimport { getPokemon } from '../store/pokemon';\n\nimport PokemonDetail from './PokemonDetail';\nimport CreatePokemonForm from './CreatePokemonForm';\nimport Fab from './Fab';\n\nconst PokemonBrowser = () => {\n\tconst { pokemonId } = useParams();\n\t// console.log('pokemonId', pokemonId);\n\tconst pokemon = useSelector(state => {\n\t\t// debugger;\n\t\treturn state.pokemon.list.map(pokemonId => state.pokemon[pokemonId]);\n\t});\n\tconst [showForm, setShowForm] = useState(false);\n\n\tconst dispatch = useDispatch();\n\tuseEffect(() => {\n\t\tdispatch(getPokemon());\n\t}, []);\n\t// console.log(pokemon);\n\n\tif (!pokemon) {\n\t\treturn null;\n\t}\n\treturn (\n\t\t<main>\n\t\t\t<nav>\n\t\t\t\t<Fab hidden={showForm} onClick={() => setShowForm(true)} />\n\t\t\t\t{pokemon.map(pokemon => {\n\t\t\t\t\treturn (\n\t\t\t\t\t\t<NavLink key={pokemon.name} to={`/pokemon/${pokemon.id}`}>\n\t\t\t\t\t\t\t<div className={Number.parseInt(pokemonId) === pokemon.id ? 'nav-entry is-selected' : 'nav-entry'}>\n\t\t\t\t\t\t\t\t<div className=\"nav-entry-image\" style={{ backgroundImage: `url('${pokemon.imageUrl}')` }}></div>\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div className=\"primary-text\">{pokemon.name}</div>\n\t\t\t\t\t\t\t\t\t<div className=\"secondary-text\">\n\t\t\t\t\t\t\t\t\t\t{pokemon.no} {pokemon.captured && '(Captured)'}\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</NavLink>\n\t\t\t\t\t);\n\t\t\t\t})}\n\t\t\t</nav>\n\t\t\t{showForm ? (\n\t\t\t\t<CreatePokemonForm hideForm={() => setShowForm(false)} />\n\t\t\t) : (\n\t\t\t\t<Route path=\"/pokemon/:pokemonId\">\n\t\t\t\t\t<PokemonDetail />\n\t\t\t\t</Route>\n\t\t\t)}\n\t\t</main>\n\t);\n};\n\nexport default PokemonBrowser;\n","/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/items.js",["56","57"],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonDetail.js",["58"],"import { useState, useEffect } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useParams } from 'react-router-dom';\nimport PokemonItems from './PokemonItems';\nimport EditPokemonForm from './EditPokemonForm';\nimport EditItemForm from './EditItemForm';\nimport { getOnePokemon } from '../store/pokemon';\n\nconst PokemonDetail = () => {\n\tconst { pokemonId } = useParams();\n\t// console.log('PokemonDetail ID', pokemonId);\n\tconst pokemon = useSelector(state => state.pokemon[pokemonId]);\n\t// console.log(pokemon);\n\tconst [showEditPokeForm, setShowEditPokeForm] = useState(false);\n\tconst [editItemId, setEditItemId] = useState(null);\n\n\tconst dispatch = useDispatch();\n\n\tuseEffect(() => {\n\t\tsetShowEditPokeForm(false);\n\t\tsetEditItemId(null);\n\t\tdispatch(getOnePokemon(pokemonId));\n\t}, [pokemonId]);\n\n\tif (!pokemon || !pokemon.moves) {\n\t\treturn null;\n\t}\n\n\tlet content = null;\n\n\tif (editItemId) {\n\t\tcontent = <EditItemForm pokemon={pokemon} itemId={editItemId} hideForm={() => setEditItemId(null)} />;\n\t} else if (showEditPokeForm && pokemon.captured) {\n\t\tcontent = <EditPokemonForm pokemon={pokemon} hideForm={() => setShowEditPokeForm(false)} />;\n\t} else {\n\t\tcontent = (\n\t\t\t<div className=\"pokemon-detail-lists\">\n\t\t\t\t<div>\n\t\t\t\t\t<h2>Information</h2>\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<b>No</b> {pokemon.no}\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<b>Type</b> {pokemon.type}\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<b>Attack</b> {pokemon.attack}\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<b>Defense</b> {pokemon.defense}\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<b>Moves</b>\n\t\t\t\t\t\t\t<ul>{pokemon.moves && pokemon.moves.map(move => <li key={move}>{move}</li>)}</ul>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<div>\n\t\t\t\t\t<h2>Items</h2>\n\t\t\t\t\t<table>\n\t\t\t\t\t\t<thead>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<th></th>\n\t\t\t\t\t\t\t\t<th>Name</th>\n\t\t\t\t\t\t\t\t<th>Happiness</th>\n\t\t\t\t\t\t\t\t<th>Price</th>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</thead>\n\t\t\t\t\t\t<tbody>\n\t\t\t\t\t\t\t<PokemonItems pokemon={pokemon} setEditItemId={setEditItemId} />\n\t\t\t\t\t\t</tbody>\n\t\t\t\t\t</table>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t);\n\t}\n\n\treturn (\n\t\t<div className=\"pokemon-detail\">\n\t\t\t<div className={`pokemon-detail-image-background`}>\n\t\t\t\t<div className=\"pokemon-detail-image\" style={{ backgroundImage: `url('${pokemon.imageUrl}')` }}></div>\n\t\t\t\t<div>\n\t\t\t\t\t<h1 className=\"bigger\">{pokemon.name}</h1>\n\t\t\t\t\t{!showEditPokeForm && pokemon.captured && <button onClick={() => setShowEditPokeForm(true)}>Edit</button>}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t{content}\n\t\t</div>\n\t);\n};\n\nexport default PokemonDetail;\n","/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/Fab.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/store/pokemon.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/CreatePokemonForm.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/PokemonItems.js",["59"],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/EditPokemonForm.js",[],"/home/nasanov/app-academy/W15/W15D3/thunks-lecture/pokedex-project/pokedex-frontend-master/src/components/EditItemForm.js",[],{"ruleId":"60","replacedBy":"61"},{"ruleId":"62","replacedBy":"63"},{"ruleId":"64","severity":1,"message":"65","line":22,"column":5,"nodeType":"66","endLine":22,"endColumn":7,"suggestions":"67"},{"ruleId":"68","severity":1,"message":"69","line":17,"column":7,"nodeType":"70","messageId":"71","endLine":17,"endColumn":10},{"ruleId":"68","severity":1,"message":"72","line":22,"column":7,"nodeType":"70","messageId":"71","endLine":22,"endColumn":13},{"ruleId":"64","severity":1,"message":"65","line":23,"column":5,"nodeType":"66","endLine":23,"endColumn":16,"suggestions":"73"},{"ruleId":"64","severity":1,"message":"74","line":14,"column":5,"nodeType":"66","endLine":14,"endColumn":17,"suggestions":"75"},"no-native-reassign",["76"],"no-negated-in-lhs",["77"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'dispatch'. Either include it or remove the dependency array.","ArrayExpression",["78"],"no-unused-vars","'add' is assigned a value but never used.","Identifier","unusedVar","'remove' is assigned a value but never used.",["79"],"React Hook useEffect has missing dependencies: 'dispatch' and 'pokemon'. Either include them or remove the dependency array.",["80"],"no-global-assign","no-unsafe-negation",{"desc":"81","fix":"82"},{"desc":"83","fix":"84"},{"desc":"85","fix":"86"},"Update the dependencies array to be: [dispatch]",{"range":"87","text":"88"},"Update the dependencies array to be: [dispatch, pokemonId]",{"range":"89","text":"90"},"Update the dependencies array to be: [dispatch, pokemon, pokemon.id]",{"range":"91","text":"92"},[708,710],"[dispatch]",[806,817],"[dispatch, pokemonId]",[420,432],"[dispatch, pokemon, pokemon.id]"]